# HTTP Service
HTTP_RABBITMQ_HOST=rabbitmq-http
HTTP_RABBITMQ_PORT=5672
HTTP_RABBITMQ_PASS=http_rabbitMQ
HTTP_RABBITMQ_USER=http_rabbitMQ
HTTP_REDIS_HOST=redis-http
HTTP_REDIS_PORT=6379

# AUTH service
AUTH_POSTGRES_HOST=postgres-auth
AUTH_POSTGRES_PORT=5432
AUTH_POSTGRES_NAME=netnotepad-auth
AUTH_POSTGRES_USER=netnotepad-auth
AUTH_POSTGRES_PASS=authDBpass
AUTH_REDIS_HOST=redis-auth
AUTH_REDIS_PORT=6379

AUTH_RABBITMQ_HOST=rabbitmq-auth
AUTH_RABBITMQ_PORT=5672
AUTH_RABBITMQ_PASS=auth_rabbitMQ
AUTH_RABBITMQ_USER=auth_rabbitMQ

# Build
# Release|Debug
DOTNET_BUILD_CONFIGURATION=Debug

# Queues
AUTH_QUEUE_NAME=auth
AUTH_INT_QUEUE_NAME=auth-internal
USER_QUEUE_NAME=user
USER_INT_QUEUE_NAME=user-internal
ICON_QUEUE_NAME=user-icon
NOTEPAD_QUEUE_NAME=notepad
NOTEPAD_INT_QUEUE_NAME=notepad-internal