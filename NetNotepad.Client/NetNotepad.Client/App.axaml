<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:NetNotepad.Client"
             x:Class="NetNotepad.Client.App">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Bitmap x:Key="AddUserIcon">/Assets/add_user_light.png</Bitmap>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Bitmap x:Key="AddUserIcon">/Assets/add_user_dark.png</Bitmap>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>