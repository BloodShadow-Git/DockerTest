<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NetNotepad.Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="NetNotepad.Client.Views.AccountSelectPage"
             x:DataType="vm:AccountSelectPageModel"
             NavigationPage.HasNavigationBar="False">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
        to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:AccountSelectPageModel />
    </Design.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="25" Spacing="15">
            <ComboBox SelectedIndex="{Binding LanguagesIndex.Value}" ItemsSource="{Binding Languages}"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" MinWidth="300" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="1"
                    Padding="25" CornerRadius="25" Background="{DynamicResource MenuFlyoutItemBackgroundPressed}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="5" Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Background="Aqua" Padding="20" CornerRadius="25" Height="450" Width="300">
                                <StackPanel Spacing="10" VerticalAlignment="Center">
                                    <Border Background="White" Height="100" Width="100" Padding="15" CornerRadius="100">
                                        <Image Source="/Assets/add_user.png" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Text="Add User" HorizontalAlignment="Center" />
                                    <TextBlock Text="192.168.0.100:8080" HorizontalAlignment="Center" />
                                    <TextBlock Text="Last login: 09.10.2026 15:00" HorizontalAlignment="Center" />
                                    <TextBlock Text="Password required at: 10.10.2026 15:00" HorizontalAlignment="Center" />
                                    <Button Command="{Binding TestCommand}" Content="TEST" />
                                </StackPanel>
                            </Border>
                            <Border Background="Aqua" CornerRadius="25" Height="450" Width="300">

                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <ToggleButton Grid.Row="0" IsChecked="{Binding ThemeSwitch.Value}"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="25">
            <Image Stretch="UniformToFill" Width="32"
                   MinHeight="{Binding $self.Width}" MaxHeight="{Binding $self.Width}" MinWidth="{Binding $self.Width}" MaxWidth="{Binding $self.Width}">
                <Image.Styles>
                    <Style Selector="ToggleButton[IsChecked=true] Image">
                        <Setter Property="Source" Value="/Assets/sun.png" />
                    </Style>
                    <Style Selector="ToggleButton[IsChecked=false] Image">
                        <Setter Property="Source" Value="/Assets/moon.png"/>
                    </Style>
                </Image.Styles>
            </Image>
        </ToggleButton>
    </Grid>
</ContentPage>