<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NetNotepad.Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="NetNotepad.Client.Views.AccountSelectPage"
             x:DataType="vm:AccountSelectPageModel"
             NavigationPage.HasNavigationBar="False">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
        to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:AccountSelectPageModel />
    </Design.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="25" Spacing="15">
            <ComboBox SelectedItem="{Binding LanguagesItem.Value}" ItemsSource="{Binding Languages}"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" MinWidth="300" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="1"
                    Padding="25" CornerRadius="25" Background="{DynamicResource MenuFlyoutItemBackgroundPressed}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding UserList}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="20" Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="350" Width="250">
                                    <Button Command="{Binding $parent[ItemsControl].DataContext.EnterCommand}"
                                            CommandParameter="{Binding}"
                                            Background="{DynamicResource MenuFlyoutItemBackgroundPressed}"
                                            Padding="20" CornerRadius="25"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                    <StackPanel Spacing="10" VerticalAlignment="Center" IsHitTestVisible="True" >
                                        <Button Command="{Binding $parent[ItemsControl].DataContext.RemoveCommand}"
                                                CommandParameter="{Binding}"
                                                Background="{DynamicResource MenuFlyoutItemForeground}"
                                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Height="100" Width="100"
                                                Padding="15" CornerRadius="100">
                                            <Image Stretch="Uniform" Source="{DynamicResource AddUserIcon}"/>
                                        </Button>
                                        <TextBlock Text="{Binding UserLogin.Value}"
                                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" IsHitTestVisible="False"/>
                                        <TextBlock Text="{Binding UserID.Value.UserServer.Value}"
                                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" IsHitTestVisible="False"/>
                                        <TextBlock Text="{Binding LastLogin.Value}"
                                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" IsHitTestVisible="False"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.RowSpan="3" Background="#7F000000" IsVisible="{Binding ShowPasswordPanel.Value}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Row="1" Grid.Column="1" Margin="25" Padding="25" CornerRadius="25" Background="{DynamicResource MenuFlyoutItemBackgroundPressed}">
                    <Button Content="Test" />
                </Border>
            </Grid>
        </Border>
        <ToggleButton Grid.Row="0" IsChecked="{Binding ThemeSwitch.Value}"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="25">
            <Image Stretch="Uniform" Width="32"
                   MinHeight="{Binding $self.Width}" MaxHeight="{Binding $self.Width}" MinWidth="{Binding $self.Width}" MaxWidth="{Binding $self.Width}">
                <Image.Styles>
                    <Style Selector="ToggleButton[IsChecked=true] Image">
                        <Setter Property="Source" Value="/Assets/sun.png" />
                    </Style>
                    <Style Selector="ToggleButton[IsChecked=false] Image">
                        <Setter Property="Source" Value="/Assets/moon.png"/>
                    </Style>
                </Image.Styles>
            </Image>
        </ToggleButton>
    </Grid>
</ContentPage>